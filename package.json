{
  "name": "media-encryption-demo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "concurrently --names='Expo Bundler,CORS Proxy' -c \"bgGreen.bold,bgMagenta.bold\" 'expo start --web' 'bun run cors-proxy/index.js'",
    "lint": "biome lint"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-media-library"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/ui": "~55.0.0-beta.2",
    "expo": "~55.0.0-preview.6",
    "expo-blob": "^0.1.7",
    "expo-build-properties": "~55.0.3",
    "expo-clipboard": "~55.0.2",
    "expo-constants": "~55.0.2",
    "expo-crypto": "~55.0.2",
    "expo-file-system": "~55.0.2",
    "expo-font": "~55.0.2",
    "expo-haptics": "~55.0.2",
    "expo-image": "~55.0.2",
    "expo-image-picker": "~55.0.2",
    "expo-linking": "~55.0.3",
    "expo-media-library": "~55.0.2",
    "expo-router": "~55.0.0-beta.3",
    "expo-splash-screen": "~55.0.2",
    "expo-status-bar": "~55.0.2",
    "expo-symbols": "~55.0.2",
    "expo-system-ui": "~55.0.2",
    "expo-web-browser": "~55.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.20.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "internal-ip": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
